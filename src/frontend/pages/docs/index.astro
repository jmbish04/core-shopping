---
/**
 * Documentation home (`/docs`): what core-shopping is, why it exists, and an
 * index of the other pages. Written from the original brief and the Maestro
 * plans; every claim about what is built was checked against the repository.
 *
 * NOTE: `src/_worker.ts` `isApiPath()` has in the past treated the exact path
 * `/docs` as Hono-owned; if this page 404s, check that guard first.
 */
import DocsPage from "@/components/docs/DocsPage.astro";
import DocRows from "@/components/docs/DocRows.astro";
import DocSection from "@/components/docs/DocSection.astro";
import { Frame, FrameDescription, FrameHeader, FramePanel, FrameTitle } from "@/components/reui/frame";
import { docsPages } from "@/lib/config";
import { ArrowRightIcon } from "lucide-react";

const parts = [
  { term: "Goals", body: "Standing briefs: what to look for, the budget, the dates, the rules that disqualify a find, and the rules that break through." },
  { term: "Runs", body: "One agent session working one or more goals: its trace, its tool calls, its scores." },
  { term: "Sightings", body: "Each thing an agent saw, matched to one canonical entity so the same concert or fare is never new twice." },
  { term: "Proposals", body: "The few finds worth your attention, each with the reason it clears the bar. A trip proposal carries a full itinerary." },
  { term: "Reviews and lessons", body: "Your verdicts and the reasons behind them become lessons that every later agent reads before it proposes anything." },
];

const liveRefs = [
  { href: "/openapi.json", label: "openapi.json", desc: "The OpenAPI 3.1 document for the whole API." },
  { href: "/scalar", label: "Scalar", desc: "Interactive API reference." },
  { href: "/swagger", label: "Swagger UI", desc: "Classic try-it-out request explorer." },
  { href: "/api/health", label: "/api/health", desc: "The Worker's health verdict, checked against live dependencies." },
];
---

<DocsPage
  title="Documentation"
  description="core-shopping is a set of personal shoppers. This is what they are for, what they were asked to do, and what exists today."
>
  <DocSection title="What this is" description="Scheduled agents look. You decide.">
    <p>
      <strong>core-shopping</strong> runs scheduled AI jobs and agentic browser sessions that go looking for concerts,
      comedy, flights, trips, products and gifts. Each find is scored against criteria you stated and checked against
      everything seen before. If it clears the bar, it reaches you as a prepared package to approve or decline.
    </p>
    <p>
      It is one Cloudflare Worker. The Worker serves this interface and the API. Shopper data lives in Postgres
      (the <code>core_shopping</code> database, reached through Hyperdrive), with pgvector columns for similarity
      search. Agents are meant to read their brief from the Worker and write what they find back to it. <a href="/docs/agent-loop">The agent loop</a> says which parts of that exist today.
    </p>
  </DocSection>

  <DocSection
    title="Why it exists: the planning burden is the barrier"
    description="The design rationale in one idea."
  >
    <p>
      A trip only happens if someone has already worked out which flight, which hotel, what time to wake up and which
      train to take. For busy people, typing out an itinerary is itself the stressful part, so the trip never starts.
    </p>
    <p>
      core-shopping moves that work to the agents. A trip arrives already planned: flight options with points and
      transfer paths, hotel options, a day-by-day itinerary with depart-by times, and a few pre-chosen forks. What is
      left for you is to review it, book it, and ask for the time off.
    </p>
    <p>
      The same reasoning holds for a concert ticket or a gift. A find only helps if it arrives with the decision
      already prepared, and if the system remembers what you decided last time.
    </p>
  </DocSection>

  <DocSection title="The five parts" description="Each is a table family in Postgres and a surface in the interface." flush>
    <DocRows rows={parts} />
  </DocSection>

  <Frame>
    <FrameHeader>
      <FrameTitle>In this documentation</FrameTitle>
      <FrameDescription>Five more pages, each short enough to read in one sitting.</FrameDescription>
    </FrameHeader>
    <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
      {
        docsPages
          .filter((page) => page.href !== "/docs")
          .map((page) => (
            <FramePanel className="p-0">
              <a href={page.href} class="group hover:bg-muted/60 flex h-full flex-col gap-1 px-4 py-3 transition-colors">
                <span class="flex items-center justify-between gap-2">
                  <span class="text-foreground group-hover:text-primary text-sm font-medium">{page.label}</span>
                  <ArrowRightIcon aria-hidden="true" className="text-muted-foreground group-hover:text-primary size-4" />
                </span>
                <span class="text-muted-foreground text-sm">{page.description}</span>
              </a>
            </FramePanel>
          ))
      }
    </div>
  </Frame>

  <Frame>
    <FrameHeader>
      <FrameTitle>Live API reference</FrameTitle>
      <FrameDescription>The OpenAPI document and both reference UIs are served by the Worker itself.</FrameDescription>
    </FrameHeader>
    <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
      {
        liveRefs.map((ref) => (
          <FramePanel className="p-0">
            <a href={ref.href} class="group hover:bg-muted/60 flex h-full flex-col gap-1 px-4 py-3 transition-colors">
              <span class="flex items-center justify-between gap-2">
                <span class="text-foreground group-hover:text-primary font-mono text-sm">{ref.label}</span>
                <ArrowRightIcon aria-hidden="true" className="text-muted-foreground group-hover:text-primary size-4" />
              </span>
              <span class="text-muted-foreground text-sm">{ref.desc}</span>
            </a>
          </FramePanel>
        ))
      }
    </div>
  </Frame>
</DocsPage>
