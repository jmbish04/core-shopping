---
/**
 * Not built yet: what the Maestro plans still hold, grouped by epic.
 *
 * This is a SNAPSHOT of the `core-shopping` project in colby-maestro taken on
 * 2026-10-17 (backlog and blocked items, plus contracts written but awaiting
 * sign-off). Maestro is the live record; this page does not query it, because
 * a docs page that silently shows stale task state is worse than one that says
 * when it was taken. Refresh it when an epic closes.
 */
import DocsPage from "@/components/docs/DocsPage.astro";
import DocRows from "@/components/docs/DocRows.astro";
import DocSection from "@/components/docs/DocSection.astro";
import type { DocRow } from "@/components/docs/types";

const backend: DocRow[] = [
  {
    term: "BE-3 MCP server",
    tag: "9 open",
    status: "planned",
    body: "The door for scheduled agents: a code-mode server at /mcp. It carries the briefing, the run lifecycle, propose, past-review lookups, goal management from chat and integration operations. It also ships the playbook and prompt templates agents run from, and an MCP App view for proposals. Until it lands, only browser runs can feed the system.",
  },
  {
    term: "BE-2 API",
    tag: "5 open",
    status: "planned",
    body: "The routes the review and proposal screens need: findings and entities, review, proposals and trip packages, lessons with a briefing preview, and settings. Goals, runs, sightings and the Overview are done.",
  },
  {
    term: "BE-5 Learning loop",
    tag: "4 open",
    status: "planned",
    body: "The reason vocabulary and verdict signals, the daily job that turns reviews into proposed lessons under a hard compute ceiling, ranking of lessons and past reviews, and scoring of each run for quality and uniqueness.",
  },
  {
    term: "BE-4 Dedupe and re-sighting",
    tag: "2 open",
    status: "planned",
    body: "Near-duplicate detection by embedding similarity, recording merge suggestions instead of merging automatically. And the policy for when a re-sighting resurfaces: a price drop, new dates, changed availability, or a calendar conflict that cleared.",
  },
  {
    term: "BE-6 Integrations",
    tag: "6 open",
    status: "planned",
    body: "Calendar checks through google-workspace-mcp, Spotify taste sync, Cloudflare Images, ingestion of reviews and tips, and Gmail deal and newsletter signals. Browser runs, the sixth task, are blocked: they run end to end, but 7 of 8 live runs failed on model output that was not JSON or came back empty.",
  },
  {
    term: "BE-8 Critical alerts",
    tag: "5 open",
    status: "planned",
    body: "The dopamine Worker connection, the notifications schema and API, the policy that decides what earns a printed receipt (caps per day and week, quiet hours, one print per find and trigger), the flag_critical operation, and a barcode round trip proven on the printer.",
  },
  {
    term: "BE-7 Operations and cost",
    tag: "4 open",
    status: "planned",
    body: "Cron triggers for the lesson job, retention purges, the stale-goal detector and the browser-run scheduler. Structured and mirrored logging with an MCP audit trail. Guards on Workers AI compute and storage. And real configuration seeded through the API.",
  },
  {
    term: "BE-1 Schema",
    tag: "2 open",
    status: "planned",
    body: "The configuration tables: people, preferences, hotel brand rules, loyalty programmes and accounts, transfer partners, travel windows, home airports, taste artists and genres, venue stances and trip history. And the index checks and retention rules for every table.",
  },
  {
    term: "Contract",
    tag: "10 open",
    status: "partial",
    body: "Eight shared contracts are written and awaiting sign-off. Two remain: configuration and integrations, and an end-to-end test in which a scripted agent session shows up in the interface.",
  },
];

