const gaps: DocRow[] = [
  {
    term: "Route announcements",
    tag: "spec-gap",
    status: "built",
    body: "The brief asks for watching SFO, OAK and SJC for newly announced direct routes. A route announcement has no dates, so it cannot be stored as a fare. It is now its own kind of entity, identified by its city pair and carrier, so the same announcement on two sites counts once while a dated fare on that pair stays separate.",
  },
  {
    term: "Occasions and sales calendar",
