---
/**
 * `/runs` — the Runs queue (maestro cs-fe-10-1).
 *
 * `client:only="react"`: the island reads its view out of the URL on mount, so
 * server-rendering it would emit markup for a different view.
 */
import { PageBody, PageToolbar } from "@/components/blocks/app-shell-2/components/page-shell";
import { RunsConsole } from "@/components/runs/runs-console";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Runs" description="Track shopper-agent work from start to finish.">
  <PageBody>
    <PageToolbar title="Runs" description="Follow active and completed research runs, including their outcomes." />
    <RunsConsole client:only="react" />
  </PageBody>
</BaseLayout>
